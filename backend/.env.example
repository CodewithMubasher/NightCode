# NightCode Backend — copy to .env and fill in your keys

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=./nightcode.db

# Providers — add the ones you use
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Tools
SERPER_API_KEY=        # for web_search tool — get free at serper.dev
